# Grok API Configuration
# Get your API key from: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Supabase Configuration
# 1. Create a new project at https://supabase.com/dashboard
# 2. Run migrations: npx supabase db push --project-ref YOUR_PROJECT_REF
#    Or apply them manually via SQL Editor in the dashboard
# 3. Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
# 4. Enable Anonymous Sign-ins: Authentication > Providers > Anonymous Sign-Ins > Enable
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
